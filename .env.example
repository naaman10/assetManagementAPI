# Local defaults. Render injects PORT in production.
PORT=3001
NODE_ENV=development

# Vercel origin of the asset management web app. Used for CORS.
WEB_APP_ORIGIN=http://localhost:3000

# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth 2.0 web client. The redirect URI is this API's callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Optional until the sending domain is verified in Resend.
# Set both to enable outbound email.
RESEND_API_KEY=
EMAIL_FROM=
