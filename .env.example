# Local defaults. Render injects PORT in production.
PORT=3001
NODE_ENV=development

# Vercel origin of the asset management web app. Used for CORS.
WEB_APP_ORIGIN=http://localhost:3000

# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth0 Regular Web Application. AUTH0_DOMAIN is the tenant host, with no scheme or path.
# AUTH0_REDIRECT_URI is the web app callback, which Next.js proxies to this API.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=

# Auth0 Machine-to-Machine application authorized for the Management API.
AUTH0_MGMT_CLIENT_ID=RoP7wi8Zcr5JTftgkmBNZT1Obi5O14PC
AUTH0_MGMT_CLIENT_SECRET=rgtuqNniM4C4mhuSHc-5KqUCbcZILgquPXCbDzMyLBCR117n9arm0DCkPzOI6aHk

# Optional. Set both to create the first admin on startup, then remove the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional until the sending domain is verified in Resend.
# Set both to enable outbound email.
RESEND_API_KEY=
EMAIL_FROM=
